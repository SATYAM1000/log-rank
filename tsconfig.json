{
  "compilerOptions":{
    "target":"ES2023",
    "module":"CommonJS",
    "declaration":true,
    "rootDir":"./src",
    "outDir":"./dist",
    "strict":true,
    "esModuleInterop":true,
    "noImplicitAny":true,
    "strictNullChecks":true
  },
  "include":["./src/**/*"],
  "exclude":["./dist", "./node_modules/"]
}
